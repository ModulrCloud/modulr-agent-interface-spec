{
  "$id": "https://github.com/ModulrCloud/modulr-agent-interface-spec/schemas/signalling/v0/connected.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signalling Connected Message",
  "description": "Indicates that a WebRTC connection has been successfully established (v0.x).",
  "type": "object",

  "allOf": [
    {
      "$ref": "../../common/v0/envelope.json"
    },
    {
      "properties": {
        "type": {
          "const": "signalling.connected"
        },
        "payload": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "description": "Unique identifier for this connection session."
            },
            "iceConnectionState": {
              "type": "string",
              "enum": ["connected", "completed"],
              "description": "The ICE connection state when connection was established."
            },
            "dataChannelState": {
              "type": "string",
              "enum": ["open"],
              "description": "The state of the data channel."
            }
          },
          "required": ["connectionId", "iceConnectionState"],
          "additionalProperties": false
        }
      },
      "required": ["payload"]
    }
  ]
}
